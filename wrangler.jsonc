    "GANG_ROLE_ID": "1550164112498229319",
    "MERCENARY_ROLE_ID": "1566086696918065194",
    "BOSS_ROLE_ID": "1566087420342964376",
    "UNDERBOSS_ROLE_ID": "1566087502576492676"
  },
  "d1_databases": [
    {
      "binding": "CREW_LOG_DB",
